datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  scanner_staff
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

enum TicketStatus {
  pending
  active
  scanned
  cancelled
  refunded
}

enum OrderStatus {
  pending
  completed
  failed
}

// Embedded (not a separate collection) — one PendingOrder can cover multiple
// tiers/quantities in a single STK push, e.g. 2x Regular + 1x VIP.
type OrderItem {
  ticketTierId String @db.ObjectId
  quantity     Int
  unitPrice    Float
}

// 1. The Staff Account / Login Identity
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String   // Hashed password string
  name      String
  role      Role     @default(admin)
  createdAt DateTime @default(now())

  tenantId  String   @db.ObjectId
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// 2. The Tenant Workspace (The Business Entity)
model Tenant {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  businessName    String
  slug            String   @unique
  logoUrl         String?
  stripeConnectId String?
  isOnboarded     Boolean  @default(false) // true once ANY payout method (Stripe, M-Pesa, bank) is fully configured

  // How the platform pays this tenant out. Buyer payments always land on the
  // platform's own paybill/till first — this is where the platform later
  // sends the tenant's share (B2C or manual bank transfer).
  payoutMethod            String? // 'mpesa' | 'bank'
  payoutPhoneNumber       String? // for 'mpesa'
  payoutBankName          String? // for 'bank' — display name
  payoutBankCode          String? // for 'bank' — IntaSend/PesaLink bank code, required for actual transfers
  payoutBankAccountName   String? // for 'bank'
  payoutBankAccountNumber String? // for 'bank'

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  events          Event[]
  tickets         Ticket[]
  pendingOrders   PendingOrder[]
  payouts         Payout[]
}

// 3. The Event
model Event {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String      // unique per tenant, used for public event URLs
  description      String?
  category         String?
  date             DateTime    // event start
  endDate          DateTime?
  location         String
  status           EventStatus @default(draft)

  coverImageUrl    String?
  galleryImageUrls String[]    @default([])

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenantId         String      @db.ObjectId
  tenant           Tenant      @relation(fields: [tenantId], references: [id])

  ticketTiers      TicketTier[]
  tickets          Ticket[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
}

model TicketTier {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    // "VIP", "Regular", "Early Bird"
  price       Float
  capacity    Int
  sold        Int       @default(0)
  isActive    Boolean   @default(true)
  salesStart  DateTime?
  salesEnd    DateTime?

  tierColor   String    @default("#000000")
  description String?

  eventId     String    @db.ObjectId
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  tickets     Ticket[]

  @@index([eventId])
}

// 4. The Ticket
model Ticket {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  ticketCode      String       @unique
  status          TicketStatus @default(pending)
  buyerName       String
  buyerEmail      String
  stripeSessionId String?      // NOT @unique — MongoDB's unique index isn't sparse by
                                // default, so every ticket without a Stripe session (i.e.
                                // every M-Pesa ticket) would collide on null. Enforce
                                // uniqueness at the application layer when Stripe checkout
                                // is built instead.
  mpesaReceiptNumber String?
  orderId         String?      @db.ObjectId // links back to the PendingOrder that produced this ticket, if any
  scannedAt       DateTime?
  createdAt       DateTime     @default(now())

  tenantId        String       @db.ObjectId
  tenant          Tenant       @relation(fields: [tenantId], references: [id])

  eventId         String       @db.ObjectId
  event           Event        @relation(fields: [eventId], references: [id])

  ticketTierId    String       @db.ObjectId
  ticketTier      TicketTier   @relation(fields: [ticketTierId], references: [id])

  @@index([tenantId])
  @@index([eventId])
  @@index([ticketTierId])
  @@index([tenantId, status])
  @@index([orderId])
}

// 5. A cart/checkout attempt paid via M-Pesa STK Push. Created before the
// buyer enters their PIN, resolved by the Daraja callback. Real Ticket rows
// are only created once status flips to 'completed' — never before, since
// STK Push has no concept of a "session" holding the buyer's intent for us.
model PendingOrder {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  status             OrderStatus @default(pending)

  buyerName          String
  buyerEmail         String
  buyerPhone         String

  totalAmount        Float
  items              OrderItem[]

  checkoutRequestId  String?     // NOT @unique — same null-collision issue as
                                  // Ticket.stripeSessionId: this is null at creation
                                  // time (set only after the STK push call returns),
                                  // so a non-sparse unique index collides on null
                                  // for every second order created.
  merchantRequestId  String?
  mpesaReceiptNumber String?
  failureReason      String?

  tenantId           String      @db.ObjectId
  tenant             Tenant      @relation(fields: [tenantId], references: [id])

  eventId            String      @db.ObjectId

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@index([checkoutRequestId])
}

enum PayoutStatus {
  pending
  completed
  failed
}

// A record of money the platform sent to a tenant (manually, outside this
// app, via the tenant's own M-Pesa or bank details). This is a ledger entry,
// not a payment trigger — recorded after you've actually sent the money.
model Payout {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  amount       Float
  method       String       // 'mpesa' | 'bank' — snapshot of how it was sent
  status       PayoutStatus @default(completed)
  initiatedBy  String?      // 'admin' | 'tenant' — who triggered this
  reference    String?      // M-Pesa transaction code or bank reference, for reconciliation
  note         String?

  // Correlation fields for automated payouts only — null for manually
  // recorded (admin "Mark as Paid") payouts.
  conversationId           String? // M-Pesa B2C
  originatorConversationId String? // M-Pesa B2C
  intasendTrackingId       String? // IntaSend bank payout
  failureReason            String?

  tenantId     String       @db.ObjectId
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  createdAt    DateTime     @default(now())

  @@index([tenantId])
  @@index([originatorConversationId])
  @@index([intasendTrackingId])
}
