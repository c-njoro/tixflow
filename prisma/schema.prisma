datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  scanner_staff
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

enum TicketStatus {
  pending
  active
  scanned
  cancelled
  refunded
}

enum OrderStatus {
  pending
  completed
  failed
}

// Embedded (not a separate collection) — one PendingOrder can cover multiple
// tiers/quantities in a single STK push, e.g. 2x Regular + 1x VIP.
type OrderItem {
  ticketTierId String @db.ObjectId
  quantity     Int
  unitPrice    Float
}

// Embedded — each gallery image needs its Cloudinary public_id alongside
// the URL so it can actually be deleted from Cloudinary later, not just
// removed from the event.
type EventImage {
  url      String
  publicId String
}

// 1. The Staff Account / Login Identity
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String   // Hashed password string
  name      String
  role      Role     @default(admin)
  createdAt DateTime @default(now())

  tenantId  String   @db.ObjectId
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// 2. The Tenant Workspace (The Business Entity)
model Tenant {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  businessName    String
  slug            String   @unique
  logoUrl         String?
  isOnboarded     Boolean  @default(false) // true once a payout method (M-Pesa or bank) is fully configured

  // How the platform pays this tenant out. Buyer payments always land on the
  // platform's own paybill/till first (Daraja STK Push) — this is where the
  // platform later sends the tenant's share via Daraja B2C (M-Pesa) or B2B
  // (bank, via the bank's own paybill).
  payoutMethod            String? // 'mpesa' | 'bank'
  payoutPhoneNumber       String? // for 'mpesa'
  payoutBankName          String? // for 'bank' — display name the tenant enters
  payoutBankPaybill       String? // for 'bank' — the bank's own M-Pesa paybill/business number, required for B2B transfers
  payoutBankAccountName   String? // for 'bank'
  payoutBankAccountNumber String? // for 'bank' — used as the B2B account reference

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  events          Event[]
  tickets         Ticket[]
  pendingOrders   PendingOrder[]
  payouts         Payout[]
}

// 3. The Event
model Event {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String      // unique per tenant, used for public event URLs
  description      String?
  category         String?
  date             DateTime    // event start
  endDate          DateTime?
  location         String
  status           EventStatus @default(draft)

  coverImageUrl      String?
  coverImagePublicId String?
  galleryImages      EventImage[]

  // Reminders to ticket holders (email + WhatsApp). The *SentAt fields are
  // also the claim that stops a reminder going out twice.
  remindersEnabled     Boolean   @default(true)
  reminderDaySentAt    DateTime?
  reminderHoursSentAt  DateTime?

  // Lipa Pole Pole — buyers pay a deposit, then the rest by a deadline.
  installmentsEnabled          Boolean @default(false)
  installmentMinDepositPercent Int     @default(25)
  installmentDueDaysBefore     Int     @default(3) // full payment due this many days before `date`

  // Attendance certificates for scanned-in attendees.
  certificatesEnabled       Boolean   @default(false)
  certificateTitle          String?   // default "Certificate of Attendance"
  certificateSignatory      String?
  certificateSignatoryTitle String?
  certificateNote           String?   // e.g. "Awarded 6 CPD points"
  certificatesSentAt        DateTime?

  // Gate: how many times a ticket may leave and come back in. 0 = no
  // re-entry (one admission). Exits are scanned so a re-entry can be told
  // apart from a second person on a copied ticket.
  reentryLimit              Int       @default(0)

  // Billing. passFeeToBuyer: the per-ticket platform fee is added to the
  // buyer's total (a "booking fee") instead of coming out of the organiser's
  // revenue. eventPlan: the paid plan unlocked for this event (free events
  // and Event Space limits — see src/lib/plans.ts); null = the default.
  passFeeToBuyer            Boolean   @default(false)
  eventPlan                 String?
  eventPlanPaidAt           DateTime?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenantId         String      @db.ObjectId
  tenant           Tenant      @relation(fields: [tenantId], references: [id])

  ticketTiers      TicketTier[]
  tickets          Ticket[]
  spaces           EventSpace[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
}

model TicketTier {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    // "VIP", "Regular", "Early Bird"
  price       Float
  capacity    Int
  sold        Int       @default(0)
  isActive    Boolean   @default(true)
  salesStart  DateTime?
  salesEnd    DateTime?

  tierColor   String    @default("#000000")
  description String?
  // Box-office price at the gate; null = same as `price`.
  doorPrice   Float?

  eventId     String    @db.ObjectId
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  tickets     Ticket[]

  @@index([eventId])
}

// 4. The Ticket
model Ticket {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  ticketCode      String       @unique
  status          TicketStatus @default(pending)
  buyerName       String
  buyerEmail      String
  mpesaReceiptNumber String?
  orderId         String?      @db.ObjectId // links back to the PendingOrder that produced this ticket, if any
  scannedAt       DateTime?
  scannedById     String?      @db.ObjectId // staff User who admitted it — per-gate stats
  certificateName String?      // name as the attendee wants it on their certificate
  // Re-entry: whether the holder is currently inside, and how many times
  // they've come back in after scanning out.
  isInside        Boolean      @default(false)
  reentryCount    Int          @default(0)
  createdAt       DateTime     @default(now())

  tenantId        String       @db.ObjectId
  tenant          Tenant       @relation(fields: [tenantId], references: [id])

  eventId         String       @db.ObjectId
  event           Event        @relation(fields: [eventId], references: [id])

  ticketTierId    String       @db.ObjectId
  ticketTier      TicketTier   @relation(fields: [ticketTierId], references: [id])

  @@index([tenantId])
  @@index([eventId])
  @@index([ticketTierId])
  @@index([tenantId, status])
  @@index([orderId])
  @@index([eventId, status])
}

// 5. A cart/checkout attempt paid via M-Pesa STK Push. Created before the
// buyer enters their PIN, resolved by the Daraja callback. Real Ticket rows
// are only created once status flips to 'completed' — never before, since
// STK Push has no concept of a "session" holding the buyer's intent for us.
model PendingOrder {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  status             OrderStatus @default(pending)

  buyerName          String
  buyerEmail         String
  buyerPhone         String

  // Optional — collected separately from buyerPhone (which is the M-Pesa
  // number used for the STK push). Purely a delivery address: tickets are
  // still looked up and owned by buyerEmail, never by this number.
  buyerWhatsapp      String?
  whatsappStatus     String?     // 'sent' | 'queued' (waiting in WhatsappOutbox) | 'failed' — null means no number was given
  whatsappError      String?

  totalAmount        Float
  items              OrderItem[]

  checkoutRequestId  String?     // NOT @unique — this is null at creation time (set
                                  // only after the STK push call returns), and MongoDB's
                                  // unique index isn't sparse by default, so a unique
                                  // index would collide on null for every second order.
  merchantRequestId  String?
  mpesaReceiptNumber String?
  failureReason      String?

  // Random secret returned only to the browser that started checkout. The
  // status endpoint (which reveals ticket codes) requires it — the order id
  // alone is a guessable ObjectId, not a secret.
  accessKey          String?

  tenantId           String      @db.ObjectId
  tenant             Tenant      @relation(fields: [tenantId], references: [id])

  eventId            String      @db.ObjectId

  // Sold through a promoter's link — commission is fixed at order time, so
  // later changes to the promoter's rate never rewrite past sales.
  promoterId         String?     @db.ObjectId
  promoterCommission Float?

  // 'purchase'            — normal checkout, tickets issued on payment
  // 'installment_deposit' — first payment of a Lipa Pole Pole plan; creates
  //                         the plan and reserves seats (planTotal and
  //                         planCommissionTotal describe the whole plan)
  // 'installment_payment' — a top-up towards an existing plan
  kind                String     @default("purchase")
  installmentPlanId   String?    @db.ObjectId
  planTotal           Float?
  planCommissionTotal Float?

  // 'mpesa' | 'card' (IntaSend) | 'cash' (box office) | 'free' | 'none' (manual)
  // Only mpesa/card money is collected by the platform and counts towards
  // the organiser's withdrawable balance.
  paymentMethod       String     @default("mpesa")
  // Box-office sale made at the gate (by this staff user).
  boxOfficeById       String?    @db.ObjectId
  // Platform fee on this order (per ticket, with a minimum) — deducted
  // from the organiser's balance. When the event passes fees to buyers,
  // it's included in totalAmount.
  platformFee         Float?
  // Before any promo discount; totalAmount is what was charged.
  subtotal            Float?
  promoCodeId         String?    @db.ObjectId
  discountAmount      Float?
  // IntaSend (card) reference.
  intasendInvoiceId   String?
  intasendCheckoutId  String?    // IntaSend hosted checkout (card orders)
  intasendSignature   String?    // lets us ask IntaSend about that checkout (valid ~1h)
  // kind 'event_plan': which plan this payment unlocks for eventId.
  eventPlanTier       String?
  // Lipa Pole Pole deposit: the platform fee on the whole plan (each
  // payment carries its share in platformFee).
  planFeeTotal        Float?

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@index([checkoutRequestId])
  @@index([status, createdAt])
  @@index([promoterId, status])
  @@index([installmentPlanId])
  @@index([promoCodeId, status])
}

// pending_approval — tenant requested + confirmed via OTP, awaiting admin review.
// processing        — admin approved, B2C/B2B sent to Daraja, waiting on the result callback.
// completed         — Daraja confirmed the money moved.
// failed            — Daraja rejected the transfer or the callback reported failure.
// rejected          — admin declined the request; nothing was ever sent.
enum PayoutStatus {
  pending_approval
  processing
  completed
  failed
  rejected
}

// A record of money the platform sent (or is sending) to a tenant. Two ways
// a Payout gets created:
//  1. Tenant self-service request (initiatedBy 'tenant') — starts at
//     pending_approval, moves to processing once an admin approves it, which
//     is when the actual Daraja B2C/B2B call fires.
//  2. Admin manually recording a transfer made outside the app
//     (initiatedBy 'admin') — created directly as 'completed', no Daraja
//     call involved. Fee fields are left null for these.
model Payout {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  amount       Float        // gross amount deducted from the tenant's balance
  method       String       // 'mpesa' | 'bank' — snapshot of how it was sent
  status       PayoutStatus @default(completed)
  initiatedBy  String?      // 'admin' | 'tenant' — who triggered this
  reference    String?      // M-Pesa transaction code or bank reference, for reconciliation
  note         String?

  // Platform's cut, taken out of `amount` at the moment the tenant requested
  // this specific payout — snapshot of PLATFORM_FEE_PERCENT at request time,
  // so a later env change never rewrites the fee on an already-made request.
  feePercent   Float?
  feeAmount    Float?
  netAmount    Float?       // amount - feeAmount — what actually reaches the tenant

  // Snapshot of where this is sent, taken at request time. Approval pays
  // out to THESE fields — never to the tenant's current settings — so
  // editing payout details after requesting can't redirect the money away
  // from what the platform admin reviewed.
  destination        String?  // human-readable summary shown to the admin
  destPhoneNumber    String?  // 'mpesa'
  destBankPaybill    String?  // 'bank'
  destAccountNumber  String?  // 'bank'

  // Correlation fields for automated (B2C/B2B) payouts only — null for
  // manually recorded (admin "Mark as Paid") payouts.
  conversationId           String? // M-Pesa B2C / B2B
  originatorConversationId String? // M-Pesa B2C / B2B
  failureReason            String?

  approvedBy   String?      // platform-admin username who approved/rejected this
  approvedAt   DateTime?

  // Set when this pays a promoter's commission (to the promoter's M-Pesa)
  // rather than the tenant themselves. netAmount is the commission; amount
  // (deducted from the tenant's balance) also covers the platform fee.
  promoterId   String?      @db.ObjectId
  // Set when this pays a buyer's approved refund (to the buyer's M-Pesa).
  refundRequestId String?   @db.ObjectId

  tenantId     String       @db.ObjectId
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  createdAt    DateTime     @default(now())

  @@index([tenantId])
  @@index([originatorConversationId])
  @@index([tenantId, status])
  @@index([status, approvedAt])
  @@index([promoterId])
}

// A one-time code emailed to a tenant admin to confirm a sensitive action
// (requesting a payout, changing payout details). Stored server-side —
// never handed to the browser — so the code can't be brute-forced offline,
// attempts can be capped, and each code can only be used once.
model OtpChallenge {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  purpose    String   // 'payout_request' | 'payout_settings' | 'promoter_payout'
  codeHash   String   // HMAC of the code with a server secret
  payload    Json     // what the code confirms, e.g. { amount } or the new payout details
  attempts   Int      @default(0)
  consumed   Boolean  @default(false)
  expiresAt  DateTime

  tenantId   String   @db.ObjectId
  userId     String   @db.ObjectId

  createdAt  DateTime @default(now())

  @@index([tenantId, purpose])
}

// ---------------------------------------------------------------------------
// Event Space — the live, in-event companion for attendees, one per room.
// Anyone with the join link/QR code can enter (the organiser controls who's
// in the room); ticket holders are sent the links shortly before the event.
// ---------------------------------------------------------------------------

// Embedded — short, few, newest first.
type SpaceAnnouncement {
  text      String
  createdAt DateTime
}

model EventSpace {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  joinCode          String   @unique // short code in the join URL / QR code
  title             String
  welcomeMessage    String?
  isOpen            Boolean  @default(true)
  moderateQuestions Boolean  @default(false) // true = questions need approval before attendees see them

  // Bumped on every change attendees could see. Attendee pages poll with
  // the version they have and only get a new payload when it moved.
  version           Int      @default(0)

  // What's live right now.
  livePollId          String?  @db.ObjectId
  liveDocumentId      String?  @db.ObjectId
  liveDocumentPage    Int      @default(1)
  spotlightQuestionId String?  @db.ObjectId
  screenMode          String   @default("join") // projector: 'join' | 'poll' | 'questions' | 'document'
  announcements       SpaceAnnouncement[]

  // Ticket-holder invites: 'pending' → 'sending' → 'sent'.
  inviteStatus      String    @default("pending")
  invitesSentAt     DateTime?
  inviteCount       Int       @default(0)

  // An event can have several spaces — one per room or track.
  eventId           String   @db.ObjectId
  event             Event    @relation(fields: [eventId], references: [id])
  tenantId          String   @db.ObjectId

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([eventId])
  @@index([tenantId])
  @@index([inviteStatus])
}

// One anonymous device in a space. participantId is a random id kept in an
// httpOnly cookie — not a login, just enough to stop casual double voting.
model SpaceParticipant {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  spaceId       String   @db.ObjectId
  participantId String
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([spaceId, participantId])
  @@index([spaceId, lastSeenAt])
}

// kind 'choice' — pick one of `options`. kind 'text' — free text, grouped
// and ranked by how many people typed the same thing (word cloud).
// status: 'draft' (not shown yet) | 'live' (accepting answers) | 'closed'.
model SpacePoll {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  spaceId       String   @db.ObjectId
  question      String
  kind          String
  options       String[]
  status        String   @default("draft")
  showResults   Boolean  @default(true)  // results visible on attendees' phones
  hiddenAnswers String[]                 // normalised text answers the organiser hid
  responseCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([spaceId])
}

model SpacePollResponse {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  pollId        String   @db.ObjectId
  spaceId       String   @db.ObjectId
  participantId String
  optionIndex   Int?     // 'choice' polls
  text          String?  // 'text' polls — as typed
  normalized    String?  // 'text' polls — grouping key
  createdAt     DateTime @default(now())

  @@unique([pollId, participantId])
  @@index([pollId])
  @@index([spaceId])
}

// status: 'pending' (awaiting approval) | 'visible' | 'answered' | 'hidden'
model SpaceQuestion {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  spaceId       String   @db.ObjectId
  participantId String
  authorName    String?
  text          String
  status        String   @default("visible")
  upvotes       Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([spaceId, status])
}

model SpaceQuestionVote {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId    String   @db.ObjectId
  spaceId       String   @db.ObjectId
  participantId String
  createdAt     DateTime @default(now())

  @@unique([questionId, participantId])
  @@index([spaceId, participantId])
}

// A programme, slides or notes. PDFs are stored on Cloudinary and served
// page by page as images, so they open instantly on any phone and the
// presenter can move everyone to the same page.
model SpaceDocument {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  spaceId   String   @db.ObjectId
  title     String
  url       String   // original file
  publicId  String
  format    String   // 'pdf' | 'jpg' | 'png' | ...
  pageCount Int      @default(1)
  createdAt DateTime @default(now())

  @@index([spaceId])
}

// Someone who sells an organiser's tickets through a tracked link
// (?ref=<code>) and earns a commission on each sale.
model Promoter {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String   @db.ObjectId
  name            String
  phone           String   // M-Pesa number commission is paid to (07XXXXXXXX)
  email           String?
  code            String   // the ?ref= value, unique per tenant
  commissionType  String   // 'percent' (of the order total) | 'fixed' (KES per ticket)
  commissionValue Float
  eventId         String?  @db.ObjectId // null = all of the tenant's events
  isActive        Boolean  @default(true)
  // Secret link to the promoter's own stats page — no login needed.
  accessToken     String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

// Lipa Pole Pole: a buyer paying for tickets over time. The deposit
// reserves the seats (counted in TicketTier.sold); tickets are issued once
// paidAmount reaches totalAmount. Each payment is a PendingOrder of kind
// 'installment_*', so revenue, reconciliation and callbacks all work as
// for normal orders.
// status: 'active' | 'completed' | 'expired' (deadline passed, seats
// released) | 'cancelled' (by the organiser, seats released)
model InstallmentPlan {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  tenantId            String      @db.ObjectId
  eventId             String      @db.ObjectId
  buyerName           String
  buyerEmail          String
  buyerPhone          String
  buyerWhatsapp       String?
  items               OrderItem[]
  totalAmount         Float
  paidAmount          Float       @default(0)
  status              String      @default("active")
  dueAt               DateTime
  accessKey           String      // secret in the buyer's plan link
  promoterId          String?     @db.ObjectId
  planCommissionTotal Float?      // commission on the whole plan; each payment earns its share
  planFeeTotal        Float?      // platform fee on the whole plan; each payment carries its share
  remindersSent       Int         @default(0)
  completedAt         DateTime?
  closedAt            DateTime?   // when it expired or was cancelled
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@index([status, dueAt])
}

// ---------------------------------------------------------------------------
// Post-event feedback survey — sent automatically after the event ends.
// ---------------------------------------------------------------------------

// kind: 'rating' (1–5) | 'choice' (one of `options`) | 'text'
type SurveyQuestion {
  id       String
  kind     String
  prompt   String
  options  String[]
  required Boolean @default(false)
}

// status: 'draft' | 'scheduled' (sends sendAfterHours after the event ends)
//         | 'sent' | 'closed' (no more responses)
model FeedbackSurvey {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  eventId        String           @unique @db.ObjectId
  tenantId       String           @db.ObjectId
  intro          String?
  questions      SurveyQuestion[]
  status         String           @default("draft")
  audience       String           @default("attended") // 'attended' (scanned in) | 'all' ticket holders
  sendAfterHours Int              @default(2)
  sentAt         DateTime?
  sentCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

// Anonymous to the organiser: respondentKey is a keyed hash of the
// respondent's email, only used to allow one response per person.
model FeedbackResponse {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  surveyId      String   @db.ObjectId
  respondentKey String
  answers       Json     // { [questionId]: number | string }
  createdAt     DateTime @default(now())

  @@unique([surveyId, respondentKey])
  @@index([surveyId])
}

// ---------------------------------------------------------------------------
// Exhibitor lead scanning — sponsors scan attendees' ticket QR codes at
// their stand to collect contacts. Organisers set exhibitors up and can
// charge for access.
// ---------------------------------------------------------------------------

model Exhibitor {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  eventId      String   @db.ObjectId
  name         String
  contactEmail String?
  accessToken  String   @unique // secret link to their scanning portal
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([eventId])
}

model ExhibitorLead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  exhibitorId String   @db.ObjectId
  eventId     String   @db.ObjectId
  ticketId    String   @db.ObjectId
  name        String
  email       String
  phone       String?
  notes       String?
  rating      Int?     // 1 (cold) – 3 (hot)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([exhibitorId, ticketId])
  @@index([exhibitorId])
}

// The QR-linked WhatsApp (Baileys) login, stored in the database instead of
// on disk so it survives restarts and deploys on hosts without a persistent
// disk (e.g. Render's free plan). One row per Baileys key: 'creds' plus one
// per signal key ("pre-key-12", "session-2547…", …). value is JSON written
// with Baileys' BufferJSON so binary keys round-trip.
model WhatsappAuthKey {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// WhatsApp messages waiting for the QR-linked (Baileys) connection — e.g.
// sent while the server was restarting. Flushed as soon as the connection
// opens (and by the scheduled jobs); dropped after 24 hours.
// status: 'queued' | 'sending' | 'sent' | 'expired' | 'failed'
model WhatsappOutbox {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  phone     String
  // { kind: 'text', texts: string[] } | { kind: 'tickets', details: {...} }
  payload   Json
  status    String    @default("queued")
  attempts  Int       @default(0)
  lastError String?
  orderId   String?   @db.ObjectId // ticket messages: updates PendingOrder.whatsappStatus when sent
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Promo codes — "use MUKURU for KES 100 off". Optionally tied to a promoter,
// who then also earns commission on every sale using it.
// ---------------------------------------------------------------------------
model PromoCode {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String    @db.ObjectId
  code          String    // stored upper-case; unique per tenant
  discountType  String    // 'percent' | 'fixed' (KES off per ticket)
  discountValue Float
  eventId       String?   @db.ObjectId // null = all of the tenant's events
  tierIds       String[]  // empty = every ticket type
  maxUses       Int?      // tickets, not orders; null = unlimited
  usedCount     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  promoterId    String?   @db.ObjectId
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

// Every gate scan, in or out — the audit trail behind re-entry and the
// gate dashboard. result: 'admitted' | 'reentry' | 'exit' | 'rejected'
model ScanLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String?  @db.ObjectId
  eventId    String   @db.ObjectId
  ticketCode String
  direction  String   // 'in' | 'out'
  result     String
  reason     String?
  staffId    String?  @db.ObjectId
  offline    Boolean  @default(false) // scanned without network, synced later
  scannedAt  DateTime
  createdAt  DateTime @default(now())

  @@index([eventId, scannedAt])
  @@index([ticketId])
}

// Buyer asks → organiser approves or rejects → platform admin pays it out
// (M-Pesa B2C, as a Payout from the organiser's balance) or marks it done.
// status: 'requested' | 'rejected' | 'approved' | 'processing' | 'completed' | 'failed'
model RefundRequest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String    @db.ObjectId
  eventId      String    @db.ObjectId
  orderId      String?   @db.ObjectId
  ticketIds    String[]  @db.ObjectId
  buyerName    String
  buyerEmail   String
  refundPhone  String    // M-Pesa number the refund goes to
  amount       Float
  reason       String
  status       String    @default("requested")
  organiserNote String?
  reviewedBy   String?   @db.ObjectId
  reviewedAt   DateTime?
  payoutId     String?   @db.ObjectId
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([status])
}

// Organiser asks to rent scanning devices / gate staff for their event day.
// status: 'requested' | 'quoted' | 'confirmed' | 'declined' | 'done'
model EquipmentRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @db.ObjectId
  eventId     String   @db.ObjectId
  devices     Int
  staff       Int
  days        Int      @default(1)
  contactName String
  contactPhone String
  notes       String?
  estimate    Float
  status      String   @default("requested")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([tenantId])
}
